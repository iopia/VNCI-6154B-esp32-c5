# VNCI 6154B / ESP32-C5 (4 MB) Wi-Fi slave: esp-hosted-mcu 2.13.1 + web UI 192.168.61.250
# ESP-IDF v6.1.1. Loaded first, then sdkconfig.defaults.esp32c5 (same values, no overrides).
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Partition table = layout of the VNCI flash (ota_0 @0x20000, ota_1 @0x200000, 1920K each)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xc000

CONFIG_SECURE_FLASH_ENC_ENABLED=n
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_BOOT_V2_ENABLED=n
CONFIG_NVS_ENCRYPTION=n

CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=n   # v11.2: validate the app on every power-on
# v11.1: KL30 dips while cranking; writing OTA/NVS without brownout detection can corrupt flash.
CONFIG_ESP_BROWNOUT_DET=y
# v11.1: task watchdog back on, 20 s, warn only (PANIC=n) - long flash erases cannot reboot the C5.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_INT_WDT=n

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LIBC_PICOLIBC=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=n
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=n

# v11.2: all logging off again (silent build).
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL=0
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_ESP_RAW_THROUGHPUT_TRANSPORT=n
CONFIG_ESP_PKT_STATS=n
CONFIG_ESP_HOSTED_FUNCTION_PROFILING=n
CONFIG_ESP_HOSTED_LOG_RUNTIME_FREERTOS_STATS=n

CONFIG_BT_ENABLED=n
CONFIG_ESP_HOSTED_CP_BT=n
CONFIG_ESP_HOSTED_CP_WIFI=y
CONFIG_ESP_HOSTED_NETWORK_SPLIT_ENABLED=n
CONFIG_IEEE802154_ENABLED=n
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_ESP_COEX_ENABLED=n
# NVS v2/v8: as factory/stock 2.13.1 - Wi-Fi config and PHY RF calibration are stored in NVS
# (nvs.net80211, phy:cal_data); calibration mode = stock default (partial, from stored data)
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_PHY_INIT_DATA_IN_PARTITION=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=y
CONFIG_ESP_PHY_RF_CAL_PARTIAL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

CONFIG_ESP_SDIO_HOST_INTERFACE=y
CONFIG_ESP_SDIO_HIGH_SPEED=y
CONFIG_ESP_SDIO_STREAMING_MODE=y
CONFIG_ESP_SDIO_CHECKSUM=n
CONFIG_ESP_SDIO_TX_Q_SIZE=20
# v2 RAM: 32 -> 20 (stock esp-hosted default), static bss 49152 -> 30720 B (-18 KB)
CONFIG_ESP_SDIO_RX_Q_SIZE=20
CONFIG_ESP_HOSTED_DEFAULT_TASK_PRIORITY=22
CONFIG_ESP_HOSTED_USE_MEMPOOL=y
CONFIG_ESP_HOSTED_MEM_MONITOR=n
CONFIG_ESP_CACHE_MALLOC=y

# TX power: 20 dBm = API/chip ceiling (esp_wifi_set_max_tx_power 80..84 -> 80)
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=20
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
# v3: back to 16 as in slave v17 (max Wi-Fi build); v2 had 10 to save ~9.6 KB heap
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
# v3: 32 as in v17
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=32
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMSDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMSDU_RX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=16
# v3: back to 32 as in v17 (v2 had 16)
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_DYNAMIC_CS_ENABLED=y
CONFIG_ESP_WIFI_2G_COEX_BW_PARAM=n
CONFIG_ESP_WIFI_SLP_BEACON_LOST_OPT=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y

# lwIP on the C5 serves only the web UI. httpd needs max_open_sockets + 3 sockets
# (was 4 -> httpd_start() failed with the default 7 open sockets).
# v2 RAM: lwIP on the C5 carries only the web UI (host traffic does not go through it),
# so lwIP code stays in flash (-~13 KB IRAM)
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_MAX_SOCKETS=12   # v11.2: headroom for httpd + host sockets (AP and STA)
# v3: lwIP = web UI only; 12 x MSS window for the speedtest (pbufs only while a transfer runs),
# mailboxes as in v17
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=23040   # v11.8: 16 MSS, full speedtest rate
CONFIG_LWIP_TCP_WND_DEFAULT=23040       # v11.8: keep window == snd_buf
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=3072
# browsers send >512 B of headers (431 otherwise); /api/nvs?ssid=..&pass=.. needs long URI
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
